## 🚀 자동 수정 도구

### **Mermaid 문법 자동 수정 스크립트**
```python
#!/usr/bin/env python3
"""
Mermaid 문법 자동 수정 도구
Mermaid 10.9.4 버전으로 업그레이드
"""

import re
import os
from pathlib import Path

class MermaidFixer:
    def __init__(self):
        self.fixes_applied = 0
        self.files_modified = 0
    
    def fix_mermaid_blocks(self, content: str) -> str:
        """Mermaid 블록 자동 수정"""
        # 1. 잘못된 언어 지정 수정
        content = re.sub(r'```graph\b', '```mermaid\nflowchart', content)
        content = re.sub(r'```sequence\b', '```mermaid\nsequenceDiagram', content)
        content = re.sub(r'```class\b', '```mermaid\nclassDiagram', content)
        content = re.sub(r'```state\b', '```mermaid\nstateDiagram-v2', content)
        content = re.sub(r'```er\b', '```mermaid\nerDiagram', content)
        content = re.sub(r'```gantt\b', '```mermaid\ngantt', content)
        content = re.sub(r'```pie\b', '```mermaid\npie', content)
        content = re.sub(r'```git\b', '```mermaid\ngitgraph', content)
        
        # 2. 다이어그램 타입 수정
        content = re.sub(r'^graph\s+', 'flowchart ', content, flags=re.MULTILINE)
        content = re.sub(r'^sequence\s+', 'sequenceDiagram\n', content, flags=re.MULTILINE)
        content = re.sub(r'^class\s+', 'classDiagram\n', content, flags=re.MULTILINE)
        content = re.sub(r'^state\s+', 'stateDiagram-v2\n', content, flags=re.MULTILINE)
        content = re.sub(r'^er\s+', 'erDiagram\n', content, flags=re.MULTILINE)
        content = re.sub(r'^gantt\s+', 'gantt\n', content, flags=re.MULTILINE)
        content = re.sub(r'^pie\s+', 'pie\n', content, flags=re.MULTILINE)
        content = re.sub(r'^git\s+', 'gitgraph\n', content, flags=re.MULTILINE)
        
        # 3. 화살표 문법 수정
        content = re.sub(r'->(?!>)', '->>', content)  # -> 를 ->> 로
        content = re.sub(r'<-(?!<)', '<<-', content)  # <- 를 <<- 로
        content = re.sub(r'-->(?!>)', '-->>', content)  # --> 를 -->> 로
        content = re.sub(r'<--(?!<)', '<<--', content)  # <-- 를 <<-- 로
        
        # 4. 노드 문법 수정
        content = re.sub(r'\(([^)]+)\)', r'[\1]', content)  # (text) 를 [text] 로
        content = re.sub(r'\(\(([^)]+)\)\)', r'[(\1)]', content)  # ((text)) 를 [(text)] 로
        
        return content
    
    def fix_file(self, file_path: Path) -> bool:
        """파일의 Mermaid 블록 수정"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                original_content = f.read()
            
            fixed_content = self.fix_mermaid_blocks(original_content)
            
            if original_content != fixed_content:
                with open(file_path, 'w', encoding='utf-8') as f:
                    f.write(fixed_content)
                
                self.files_modified += 1
                print(f"✅ 수정됨: {file_path}")
                return True
            else:
                print(f"⏭️ 변경사항 없음: {file_path}")
                return False
        
        except Exception as e:
            print(f"❌ 오류: {file_path} - {str(e)}")
            return False
    
    def fix_all_files(self, knowledge_base_path: Path):
        """모든 마크다운 파일 수정"""
        md_files = list(knowledge_base_path.rglob("*.md"))
        
        print(f"🔧 {len(md_files)}개 마크다운 파일 수정 중...")
        
        for md_file in md_files:
            self.fix_file(md_file)
        
        print(f"\n📊 수정 완료: {self.files_modified}개 파일 수정됨")

def main():
    """메인 실행 함수"""
    fixer = MermaidFixer()
    knowledge_base = Path("mcp_knowledge_base")
    
    if not knowledge_base.exists():
        print("❌ mcp_knowledge_base 디렉토리를 찾을 수 없습니다.")
        return
    
    fixer.fix_all_files(knowledge_base)

if __name__ == "__main__":
    main()
```


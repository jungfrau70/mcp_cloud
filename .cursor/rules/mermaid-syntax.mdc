## 🔧 자동 검증 도구

### **Mermaid 문법 검증 스크립트**
```python
#!/usr/bin/env python3
"""
Mermaid 문법 검증 도구
Mermaid 10.9.4 버전 호환성 확인
"""

import re
import os
from pathlib import Path

class MermaidValidator:
    def __init__(self):
        self.errors = []
        self.warnings = []
    
    def validate_mermaid_block(self, content: str, line_number: int) -> bool:
        """Mermaid 블록 문법 검증"""
        is_valid = True
        
        # 1. 언어 지정 확인
        if not content.strip().startswith('```mermaid'):
            self.errors.append(f"라인 {line_number}: Mermaid 블록은 '```mermaid'로 시작해야 합니다.")
            is_valid = False
        
        # 2. 다이어그램 타입 확인
        mermaid_content = content.replace('```mermaid', '').replace('```', '').strip()
        
        # 잘못된 다이어그램 타입 검사
        invalid_types = ['graph', 'sequence', 'class', 'state', 'er', 'gantt', 'pie', 'git']
        for invalid_type in invalid_types:
            if mermaid_content.startswith(invalid_type + ' '):
                self.errors.append(f"라인 {line_number}: '{invalid_type}'는 더 이상 지원되지 않습니다. 올바른 타입을 사용하세요.")
                is_valid = False
        
        # 3. 노드 문법 검사
        if 'flowchart' in mermaid_content or 'graph' in mermaid_content:
            is_valid &= self._validate_flowchart_syntax(mermaid_content, line_number)
        
        # 4. 시퀀스 다이어그램 검사
        if 'sequenceDiagram' in mermaid_content:
            is_valid &= self._validate_sequence_syntax(mermaid_content, line_number)
        
        return is_valid
    
    def _validate_flowchart_syntax(self, content: str, line_number: int) -> bool:
        """플로우차트 문법 검증"""
        is_valid = True
        
        # 잘못된 노드 타입 검사
        invalid_nodes = ['(text)', '((text))', '>text]']
        for invalid_node in invalid_nodes:
            if invalid_node in content:
                self.errors.append(f"라인 {line_number}: 잘못된 노드 타입 '{invalid_node}' 사용")
                is_valid = False
        
        return is_valid
    
    def _validate_sequence_syntax(self, content: str, line_number: int) -> bool:
        """시퀀스 다이어그램 문법 검증"""
        is_valid = True
        
        # 잘못된 화살표 검사
        invalid_arrows = ['->', '<-', '-->', '<--']
        for invalid_arrow in invalid_arrows:
            if invalid_arrow in content:
                self.errors.append(f"라인 {line_number}: 잘못된 화살표 '{invalid_arrow}' 사용. '->>' 또는 '-->>' 사용하세요.")
                is_valid = False
        
        return is_valid
    
    def validate_file(self, file_path: Path) -> dict:
        """파일의 Mermaid 블록 검증"""
        result = {
            'file': str(file_path),
            'is_valid': True,
            'errors': [],
            'warnings': []
        }
        
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Mermaid 블록 찾기
            mermaid_blocks = re.finditer(r'```mermaid\n(.*?)\n```', content, re.DOTALL)
            
            for match in mermaid_blocks:
                block_content = match.group(0)
                line_number = content[:match.start()].count('\n') + 1
                
                if not self.validate_mermaid_block(block_content, line_number):
                    result['is_valid'] = False
                    result['errors'].extend(self.errors)
                    result['warnings'].extend(self.warnings)
        
        except Exception as e:
            result['is_valid'] = False
            result['errors'].append(f"파일 읽기 오류: {str(e)}")
        
        return result

def main():
    """메인 실행 함수"""
    validator = MermaidValidator()
    knowledge_base = Path("mcp_knowledge_base")
    
    if not knowledge_base.exists():
        print("❌ mcp_knowledge_base 디렉토리를 찾을 수 없습니다.")
        return
    
    # 모든 마크다운 파일 검사
    md_files = list(knowledge_base.rglob("*.md"))
    
    print(f"🔍 {len(md_files)}개 마크다운 파일 검사 중...")
    
    total_errors = 0
    for md_file in md_files:
        result = validator.validate_file(md_file)
        
        if not result['is_valid']:
            print(f"\n❌ {result['file']}")
            for error in result['errors']:
                print(f"  - {error}")
                total_errors += 1
        else:
            print(f"✅ {result['file']}")
    
    print(f"\n📊 검사 완료: {total_errors}개 오류 발견")
    
    if total_errors > 0:
        print("\n🔧 자동 수정을 실행하시겠습니까? (y/n)")
        # 자동 수정 로직 추가 가능

if __name__ == "__main__":
    main()
```


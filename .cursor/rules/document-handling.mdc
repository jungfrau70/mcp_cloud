### **제목 추출 로직 (교육 특화)**
```typescript
// ✅ DO: 교육 문서 제목 추출
const titleText = computed(() => {
  if (!props.content) return '';
  
  // 교육 과정 제목 추출 (이모지 포함)
  const match = props.content.match(/^\s*#{1,6}\s+(.+)$/m);
  if (match) {
    const title = match[1].trim();
    // 교육 과정 제목 정리
    return title.replace(/^🎯\s*/, '').replace(/^📚\s*/, '').trim();
  }
  
  // Fallback: 파일명에서 교육 과정 제목 생성
  return props.path ? 
    props.path.split('/').pop()
      .replace(/_/g, ' ')
      .replace(/\.md$/i, '') : '';
});
```


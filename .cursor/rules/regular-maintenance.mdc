## 🔧 자동화 스크립트

### **주간 감사 스크립트**
```python
#!/usr/bin/env python3
"""
주간 자동 감사 스크립트
매주 금요일 오후 6시에 실행
"""

import os
import json
from datetime import datetime
from anchor_link_audit import AnchorLinkAuditor
from fix_anchor_links_advanced import AdvancedAnchorLinkFixer

def weekly_audit():
    """주간 자동 감사 실행"""
    print(f"🔍 주간 감사 시작: {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    
    # 1. 전체 감사 실행
    auditor = AnchorLinkAuditor()
    auditor.load_all_documents()
    
    # 2. 문제 수집
    bottom_up_issues = auditor.bottom_up_validation()
    top_down_issues = auditor.top_down_validation()
    
    total_issues = bottom_up_issues + top_down_issues
    
    # 3. 자동 수정 시도
    if total_issues > 0:
        print(f"🔧 {total_issues}개 문제 발견, 자동 수정 시도")
        
        fixer = AdvancedAnchorLinkFixer()
        fixer.fix_all_remaining_issues()
        
        # 4. 수정 후 재검증
        auditor.load_all_documents()
        remaining_issues = auditor.bottom_up_validation()
        
        print(f"✅ 자동 수정 완료, 남은 문제: {remaining_issues}개")
    else:
        print("✅ 모든 앵커 링크가 정상입니다!")
    
    # 5. 주간 보고서 생성
    generate_weekly_report(total_issues, remaining_issues if 'remaining_issues' in locals() else 0)

def generate_weekly_report(initial_issues, remaining_issues):
    """주간 보고서 생성"""
    report = {
        "date": datetime.now().isoformat(),
        "initial_issues": initial_issues,
        "remaining_issues": remaining_issues,
        "fixed_issues": initial_issues - remaining_issues,
        "fix_rate": (initial_issues - remaining_issues) / initial_issues * 100 if initial_issues > 0 else 100
    }
    
    with open(f"weekly_audit_report_{datetime.now().strftime('%Y%m%d')}.json", 'w', encoding='utf-8') as f:
        json.dump(report, f, ensure_ascii=False, indent=2)
    
    print(f"📊 주간 보고서 생성: weekly_audit_report_{datetime.now().strftime('%Y%m%d')}.json")

if __name__ == "__main__":
    weekly_audit()
```

### **월간 검토 스크립트**
```python
#!/usr/bin/env python3
"""
월간 검토 스크립트
매월 첫째 주 월요일에 실행
"""

import os
import json
from datetime import datetime, timedelta
from pathlib import Path

def monthly_review():
    """월간 검토 실행"""
    print(f"📊 월간 검토 시작: {datetime.now().strftime('%Y-%m-%d')}")
    
    # 1. 지난 4주간의 주간 보고서 분석
    weekly_reports = []
    for i in range(4):
        date = datetime.now() - timedelta(weeks=i)
        report_file = f"weekly_audit_report_{date.strftime('%Y%m%d')}.json"
        
        if os.path.exists(report_file):
            with open(report_file, 'r', encoding='utf-8') as f:
                weekly_reports.append(json.load(f))
    
    # 2. 트렌드 분석
    if weekly_reports:
        avg_issues = sum(r['remaining_issues'] for r in weekly_reports) / len(weekly_reports)
        avg_fix_rate = sum(r['fix_rate'] for r in weekly_reports) / len(weekly_reports)
        
        print(f"📈 지난 4주 평균 문제 수: {avg_issues:.1f}개")
        print(f"📈 지난 4주 평균 수정률: {avg_fix_rate:.1f}%")
        
        # 3. 품질 지표 생성
        quality_metrics = {
            "month": datetime.now().strftime('%Y-%m'),
            "average_issues": avg_issues,
            "average_fix_rate": avg_fix_rate,
            "trend": "improving" if avg_issues < 5 else "stable" if avg_issues < 10 else "needs_attention",
            "recommendations": generate_recommendations(avg_issues, avg_fix_rate)
        }
        
        # 4. 월간 보고서 저장
        with open(f"monthly_review_{datetime.now().strftime('%Y%m')}.json", 'w', encoding='utf-8') as f:
            json.dump(quality_metrics, f, ensure_ascii=False, indent=2)
        
        print(f"📊 월간 보고서 생성: monthly_review_{datetime.now().strftime('%Y%m')}.json")

def generate_recommendations(avg_issues, avg_fix_rate):
    """개선 권장사항 생성"""
    recommendations = []
    
    if avg_issues > 10:
        recommendations.append("앵커 링크 품질 개선이 필요합니다. 추가 자동화 도구 도입을 검토하세요.")
    
    if avg_fix_rate < 80:
        recommendations.append("자동 수정률이 낮습니다. 매칭 로직 개선이 필요합니다.")
    
    if avg_issues < 5 and avg_fix_rate > 90:
        recommendations.append("훌륭한 품질을 유지하고 있습니다! 현재 프로세스를 계속 유지하세요.")
    
    return recommendations

if __name__ == "__main__":
    monthly_review()
```


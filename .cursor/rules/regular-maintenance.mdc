        self.metrics = {
            "total_documents": 0,
            "valid_links": 0,
            "invalid_links": 0,
            "coverage_rate": 0.0,
            "last_audit": None,
            "trend": "stable"
        }
    
    def update_metrics(self):
        """메트릭 업데이트"""
        # 실시간 메트릭 계산
        pass
    
    def get_health_score(self):
        """건강도 점수 계산 (0-100)"""
        if self.metrics["total_documents"] == 0:
            return 0
        
        coverage_score = self.metrics["coverage_rate"] * 50
        quality_score = (self.metrics["valid_links"] / 
                        (self.metrics["valid_links"] + self.metrics["invalid_links"])) * 50
        
        return coverage_score + quality_score

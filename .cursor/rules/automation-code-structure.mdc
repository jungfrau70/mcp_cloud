### **서브 모듈 표준 구조**
```bash
# ✅ DO: 서브 실행 모듈 구조
#!/bin/bash

# [Service] Helper 모듈
# 역할: [클라우드 서비스] 관련 작업 실행 (조회/수정/삭제/생성)
# 
# 사용법:
#   ./[service]-helper.sh --action <액션> --provider <프로바이더>

# =============================================================================
# 환경 설정 로드
# =============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 공통 환경 설정 로드
if [ -f "$SCRIPT_DIR/common-environment.env" ]; then
    source "$SCRIPT_DIR/common-environment.env"
else
    echo "ERROR: 공통 환경 설정 파일을 찾을 수 없습니다"
    exit 1
fi

# =============================================================================
# 사용법 출력
# =============================================================================
usage() {
    cat << EOF
[Service] Helper 모듈

사용법:
  $0 --action <액션> [옵션]

액션:
  create                  # 리소스 생성
  delete                  # 리소스 삭제
  status                  # 리소스 상태 확인
  update                  # 리소스 업데이트
  cleanup                 # 전체 정리

옵션:
  --provider <provider>   # 클라우드 프로바이더 (기본값: aws)
  --resource-name <name>  # 리소스 이름 (기본값: 환경변수)
  --help, -h              # 도움말 표시

예시:
  $0 --action create
  $0 --action status --provider gcp
  $0 --action cleanup
EOF
}

# =============================================================================
# 환경 검증
# =============================================================================
validate_environment() {
    log_step "[Service] 환경 검증 중..."
    
    # 기본 도구 확인
    if ! check_command "kubectl"; then
        log_error "kubectl이 설치되지 않았습니다."
        return 1
    fi
    
    # 프로바이더별 도구 확인
    case "$provider" in
        "aws")
            if ! check_command "aws"; then
                log_error "AWS CLI가 설치되지 않았습니다."
                return 1
            fi
            if ! aws sts get-caller-identity &> /dev/null; then
                log_error "AWS 자격 증명이 설정되지 않았습니다."
                return 1
            fi
            ;;
        "gcp")
            if ! check_command "gcloud"; then
                log_error "gcloud CLI가 설치되지 않았습니다."
                return 1
            fi
            if ! gcloud auth list --filter=status:ACTIVE --format="value(account)" | head -n1 &> /dev/null; then
                log_error "GCP 자격 증명이 설정되지 않았습니다."
                return 1
            fi
            ;;
    esac
    
    log_success "[Service] 환경 검증 완료"
    return 0
}

# =============================================================================
# 리소스 존재 확인 (핵심 기능)
# =============================================================================
check_resource_exists() {
    local resource_name="${1:-$DEFAULT_RESOURCE_NAME}"
    
    # 프로바이더별 리소스 확인 로직
    case "$provider" in
        "aws")
            # AWS 리소스 확인 로직
            if aws [service] describe-[resource] --name "$resource_name" --region "$AWS_REGION" &> /dev/null; then
                return 0
            else
                return 1
            fi
            ;;
        "gcp")
            # GCP 리소스 확인 로직
            if gcloud [service] [resource] describe "$resource_name" --zone="$GCP_ZONE" &> /dev/null; then
                return 0
            else
                return 1
            fi
            ;;
    esac
}

# =============================================================================
# 리소스 생성 (기존 리소스 확인 포함)
# =============================================================================
create_resource() {
    local resource_name="${1:-$DEFAULT_RESOURCE_NAME}"
    
    log_header "[Service] 리소스 생성: $resource_name"
    
    # 기존 리소스 확인
    if check_resource_exists "$resource_name"; then
        log_warning "리소스가 이미 존재합니다: $resource_name"
        log_info "기존 리소스를 사용하여 다음 단계를 진행합니다."
        update_progress "resource-check" "existing" "기존 리소스 사용: $resource_name"
        return 0
    fi
    
    log_info "새 [Service] 리소스 생성 시작: $resource_name"
    update_progress "resource-create" "started" "[Service] 리소스 생성 시작"
    
    # 리소스 생성 로직
    case "$provider" in
        "aws")
            # AWS 리소스 생성
            aws [service] create-[resource] --name "$resource_name" --region "$AWS_REGION"
            ;;
        "gcp")
            # GCP 리소스 생성
            gcloud [service] [resource] create "$resource_name" --zone="$GCP_ZONE"
            ;;
    esac
    
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        log_success "[Service] 리소스 생성 완료: $resource_name"
        update_progress "resource-create" "completed" "[Service] 리소스 생성 완료"
        return 0
    else
        log_error "[Service] 리소스 생성 실패: $resource_name"
        update_progress "resource-create" "failed" "[Service] 리소스 생성 실패"
        return 1
    fi
}

# =============================================================================
# 리소스 삭제
# =============================================================================
delete_resource() {
    local resource_name="${1:-$DEFAULT_RESOURCE_NAME}"
    
    log_header "[Service] 리소스 삭제: $resource_name"
    
    # 리소스 존재 확인
    if ! check_resource_exists "$resource_name"; then
        log_warning "삭제할 리소스가 존재하지 않습니다: $resource_name"
        update_progress "resource-delete" "skipped" "리소스가 존재하지 않음"
        return 0
    fi
    
    log_info "[Service] 리소스 삭제 시작: $resource_name"
    update_progress "resource-delete" "started" "[Service] 리소스 삭제 시작"
    
    # 리소스 삭제 로직
    case "$provider" in
        "aws")
            aws [service] delete-[resource] --name "$resource_name" --region "$AWS_REGION"
            ;;
        "gcp")
            gcloud [service] [resource] delete "$resource_name" --zone="$GCP_ZONE" --quiet
            ;;
    esac
    
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        log_success "[Service] 리소스 삭제 완료: $resource_name"
        update_progress "resource-delete" "completed" "[Service] 리소스 삭제 완료"
        return 0
    else
        log_error "[Service] 리소스 삭제 실패: $resource_name"
        update_progress "resource-delete" "failed" "[Service] 리소스 삭제 실패"
        return 1
    fi
}

# =============================================================================
# 리소스 상태 확인
# =============================================================================
check_resource_status() {
    local resource_name="${1:-$DEFAULT_RESOURCE_NAME}"
    
    log_header "[Service] 리소스 상태 확인: $resource_name"
    
    if ! check_resource_exists "$resource_name"; then
        log_warning "리소스가 존재하지 않습니다: $resource_name"
        return 1
    fi
    
    # 리소스 정보 조회
    log_info "리소스 기본 정보:"
    case "$provider" in
        "aws")
            aws [service] describe-[resource] --name "$resource_name" --region "$AWS_REGION" --output table
            ;;
        "gcp")
            gcloud [service] [resource] describe "$resource_name" --zone="$GCP_ZONE" --format="table(name,status,region)"
            ;;
    esac
    
    update_progress "resource-status" "completed" "리소스 상태 확인 완료"
    return 0
}

# =============================================================================
# 전체 정리
# =============================================================================
cleanup_all() {
    log_header "[Service] 환경 전체 정리"
    
    # 리소스 삭제
    delete_resource
    
    update_progress "cleanup" "completed" "전체 정리 완료"
}

# =============================================================================
# 메인 실행 로직
# =============================================================================
main() {
    local action=""
    local provider="aws"
    local resource_name="$DEFAULT_RESOURCE_NAME"
    
    # 인수 파싱
    while [[ $# -gt 0 ]]; do
        case $1 in
            --action)
                action="$2"
                shift 2
                ;;
            --provider)
                provider="$2"
                shift 2
                ;;
            --resource-name)
                resource_name="$2"
                shift 2
                ;;
            --help|-h)
                # --help 옵션 처리
                if [ "$2" = "--action" ] && [ -n "$3" ]; then
                    handle_help_option "$3"
                else
                    usage
                    exit 0
                fi
                ;;
            *)
                log_error "알 수 없는 옵션: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    # 액션이 지정되지 않은 경우
    if [ -z "$action" ]; then
        log_error "액션이 지정되지 않았습니다."
        usage
        exit 1
    fi
    
    # 환경 검증
    if ! validate_environment; then
        log_error "환경 검증 실패"
        exit 1
    fi
    
    # 액션 실행
    case "$action" in
        "create")
            create_resource "$resource_name"
            ;;
        "delete")
            delete_resource "$resource_name"
            ;;
        "status")
            check_resource_status "$resource_name"
            ;;
        "update")
            log_info "리소스 업데이트 기능은 추후 구현 예정입니다."
            ;;
        "cleanup")
            cleanup_all
            ;;
        *)
            log_error "알 수 없는 액션: $action"
            usage
            exit 1
            ;;
    esac
    
    # 실행 요약 보고
    generate_summary
}

# =============================================================================
# 스크립트 실행
# =============================================================================
main "$@"
```


## 📋 메뉴 시스템 규칙

### **메뉴 시스템 역할 제한**
```bash
# ✅ DO: 메뉴 시스템 구조
#!/bin/bash

# Cloud Intermediate Day N 실습 메뉴 시스템
# 역할: 사용자에게 서비스 실행 모듈을 호출할 수 있는 메뉴 제공 역할에 한정

# =============================================================================
# 환경 설정 로드
# =============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="${SCRIPT_DIR}/../../tools/cloud"

# 공통 환경 설정 로드
source "$TOOLS_DIR/common-environment.env"

# =============================================================================
# 서브 실행 모듈 호출 함수
# =============================================================================
call_sub_module() {
    local module_name="$1"
    local action="$2"
    local provider="${3:-aws}"
    
    local module_path="$TOOLS_DIR/$module_name"
    
    if [ ! -f "$module_path" ]; then
        log_error "서브 실행 모듈을 찾을 수 없습니다: $module_path"
        return 1
    fi
    
    if [ ! -x "$module_path" ]; then
        log_error "서브 실행 모듈에 실행 권한이 없습니다: $module_path"
        return 1
    fi
    
    log_info "서브 실행 모듈 호출: $module_name"
    log_info "액션: $action, 프로바이더: $provider"
    
    # 환경 설정 로드
    case "$provider" in
        "aws")
            source "$TOOLS_DIR/aws-environment.env"
            ;;
        "gcp")
            source "$TOOLS_DIR/gcp-environment.env"
            ;;
    esac
    
    # 서브 모듈 실행
    "$module_path" --action "$action" --provider "$provider"
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        log_success "서브 실행 모듈 완료: $module_name"
    else
        log_error "서브 실행 모듈 실패: $module_name (종료 코드: $exit_code)"
    fi
    
    return $exit_code
}

# =============================================================================
# 메뉴 표시 및 처리
# =============================================================================
show_main_menu() {
    clear
    log_header "Cloud Intermediate Day N 실습 메뉴"
    echo ""
    echo "1. 🐳 Docker 고급 실습"
    echo "2. ☸️  Kubernetes 기초 실습"
    echo "3. ☁️  클라우드 컨테이너 서비스 실습"
    echo "4. 📊 통합 모니터링 허브 구축"
    echo "5. 🔍 클러스터 현황 확인"
    echo "6. 🚀 배포 관리"
    echo "7. ⚙️  클러스터 관리"
    echo "8. 🧹 실습 환경 정리"
    echo "9. 📋 현재 리소스 상태 확인"
    echo "0. 종료"
    echo ""
}

# ❌ DON'T: 메뉴 시스템에서 비즈니스 로직 구현
# 메뉴 시스템은 오직 사용자 인터페이스와 서브 모듈 호출만 담당
```

## 🔧 서브 실행 모듈 규칙

### **--help 옵션 필수 구현**
```bash
# ✅ DO: --help 옵션 구현 (필수)
usage() {
    cat << EOF
[Service] Helper 모듈

사용법:
  $0 --action <액션> [옵션]

액션:
  create                  # 리소스 생성
  delete                  # 리소스 삭제
  status                  # 리소스 상태 확인
  update                  # 리소스 업데이트
  cleanup                 # 전체 정리

옵션:
  --provider <provider>   # 클라우드 프로바이더 (기본값: aws)
  --resource-name <name>  # 리소스 이름 (기본값: 환경변수)
  --help, -h              # 도움말 표시

예시:
  $0 --action create
  $0 --action status --provider gcp
  $0 --action cleanup

상세 사용법:
  $0 --help --action create     # create 액션 상세 사용법
  $0 --help --action delete     # delete 액션 상세 사용법
  $0 --help --action status     # status 액션 상세 사용법
EOF
}

# ✅ DO: 액션별 상세 사용법 함수
show_action_help() {
    local action="$1"
    
    case "$action" in
        "create")
            cat << EOF
CREATE 액션 상세 사용법:

기능:
  - 새로운 [Service] 리소스를 생성합니다
  - 기존 리소스가 있으면 재사용합니다
  - 생성 과정을 실시간으로 추적합니다

사용법:
  $0 --action create [옵션]

옵션:
  --provider <provider>   # 클라우드 프로바이더 (aws, gcp)
  --resource-name <name>  # 리소스 이름 (기본값: 환경변수)
  --region <region>       # 리전 (기본값: 환경변수)
  --tags <tags>           # 태그 (JSON 형식)

예시:
  $0 --action create
  $0 --action create --provider gcp --resource-name my-resource
  $0 --action create --tags '{"Environment":"Learning","Project":"CloudIntermediate"}'

생성되는 리소스:
  - [Service] 리소스
  - 관련 보안 그룹
  - 로그 그룹 (해당하는 경우)
  - 모니터링 설정

진행 상황:
  - 환경 검증
  - 기존 리소스 확인
  - 리소스 생성
  - 상태 확인
  - 완료 보고
EOF
            ;;
        "delete")
            cat << EOF
DELETE 액션 상세 사용법:

기능:
  - [Service] 리소스를 안전하게 삭제합니다
  - 관련 리소스도 함께 정리합니다
  - 삭제 전 확인 절차를 거칩니다

사용법:
  $0 --action delete [옵션]

옵션:
  --provider <provider>   # 클라우드 프로바이더 (aws, gcp)
  --resource-name <name>  # 삭제할 리소스 이름
  --force                 # 확인 없이 강제 삭제
  --keep-logs             # 로그 그룹 유지

예시:
  $0 --action delete
  $0 --action delete --provider gcp --resource-name my-resource
  $0 --action delete --force

삭제되는 리소스:
  - [Service] 리소스
  - 관련 보안 그룹
  - 로그 그룹 (--keep-logs 옵션 없을 경우)
  - 모니터링 설정

주의사항:
  - 삭제된 리소스는 복구할 수 없습니다
  - --force 옵션 사용 시 확인 없이 삭제됩니다
  - 로그 그룹은 별도로 삭제해야 할 수 있습니다
EOF
            ;;
        "status")
            cat << EOF
STATUS 액션 상세 사용법:

기능:
  - [Service] 리소스의 현재 상태를 확인합니다
  - 상세 정보를 테이블 형태로 출력합니다
  - 관련 리소스 상태도 함께 확인합니다

사용법:
  $0 --action status [옵션]

옵션:
  --provider <provider>   # 클라우드 프로바이더 (aws, gcp)
  --resource-name <name>  # 확인할 리소스 이름
  --format <format>       # 출력 형식 (table, json, yaml)
  --verbose               # 상세 정보 출력

예시:
  $0 --action status
  $0 --action status --provider gcp --resource-name my-resource
  $0 --action status --format json --verbose

확인되는 정보:
  - 리소스 기본 정보
  - 상태 및 상태 메시지
  - 생성 시간 및 수정 시간
  - 관련 리소스 목록
  - 태그 정보

출력 형식:
  - table: 테이블 형태 (기본값)
  - json: JSON 형태
  - yaml: YAML 형태
EOF
            ;;
        *)
            cat << EOF
알 수 없는 액션: $action

사용 가능한 액션:
  - create: 리소스 생성
  - delete: 리소스 삭제
  - status: 리소스 상태 확인
  - update: 리소스 업데이트
  - cleanup: 전체 정리

각 액션의 상세 사용법을 보려면:
  $0 --help --action <액션명>
EOF
            ;;
    esac
}

# ✅ DO: --help 옵션 처리 로직
handle_help_option() {
    local action="$1"
    
    if [ -n "$action" ]; then
        show_action_help "$action"
    else

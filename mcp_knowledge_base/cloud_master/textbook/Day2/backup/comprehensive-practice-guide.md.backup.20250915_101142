#### GCP GKE 종합 배포 스크립트
```bash
#!/bin/bash
# gcp-gke-comprehensive-deployment.sh

echo "=== GCP GKE 종합 배포 시작 ==="

# 1. GKE 클러스터 생성
echo "1. GKE 클러스터 생성"
gcloud container clusters create my-gke-cluster \
  --zone us-central1-a \
  --num-nodes 2 \
  --machine-type e2-medium \
  --enable-autoscaling \
  --min-nodes 1 \
  --max-nodes 10 \
  --enable-monitoring \
  --enable-logging

# 2. 클러스터 연결
echo "2. 클러스터 연결"
gcloud container clusters get-credentials my-gke-cluster --zone us-central1-a

# 3. 메트릭 서버 설치
echo "3. 메트릭 서버 설치"
kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

# 4. 애플리케이션 배포
echo "4. 애플리케이션 배포"
kubectl apply -f deployment.yaml
kubectl apply -f service.yaml
kubectl apply -f ingress.yaml

# 5. HPA 설정
echo "5. HPA 설정"
kubectl apply -f hpa.yaml

# 6. 모니터링 설정
echo "6. 모니터링 설정"
gcloud monitoring policies create \
  --notification-channels=projects/my-project/notificationChannels/123 \
  --display-name="GKE High CPU Alert" \
  --conditions='displayName=High CPU, conditionThreshold={filter="metric.type=\"kubernetes.io/container/cpu/core_usage_time\"", comparison=COMPARISON_GT, thresholdValue=0.8, duration="300s"}'

# 7. 비용 관리 설정
echo "7. 비용 관리 설정"
gcloud alpha billing budgets create \
  --billing-account=BILLING_ACCOUNT_ID \
  --display-name="GKE Monthly Budget" \
  --budget-amount=500 \
  --threshold-rule=percent=0.8 \
  --threshold-rule=percent=1.0 \
  --filter-projects="projects/my-project"

echo "=== GCP GKE 종합 배포 완료 ==="
```

### 부하 테스트 스크립트

#### 부하 테스트 및 스케일링 확인
```bash
#!/bin/bash
# load-test-and-scaling.sh

echo "=== 부하 테스트 및 스케일링 확인 시작 ==="

# 1. 초기 상태 확인
echo "1. 초기 상태 확인"
kubectl get pods
kubectl get hpa

# 2. 부하 테스트 실행
echo "2. 부하 테스트 실행"
kubectl run -i --tty load-generator --rm --image=busybox --restart=Never -- /bin/sh

# 부하 테스트 명령어 (kubectl run 내부에서 실행)
# while true; do wget -q -O- http://web-service; done

# 3. 스케일링 모니터링
echo "3. 스케일링 모니터링"
watch -n 5 'kubectl get pods && kubectl get hpa'

# 4. 부하 제거 후 스케일 인 확인
echo "4. 부하 제거 후 스케일 인 확인"
kubectl delete pod load-generator

# 5. 최종 상태 확인
echo "5. 최종 상태 확인"
kubectl get pods
kubectl get hpa
kubectl describe hpa web-app-hpa

echo "=== 부하 테스트 및 스케일링 확인 완료 ==="
```


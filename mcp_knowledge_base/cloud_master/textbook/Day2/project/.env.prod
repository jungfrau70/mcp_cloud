# Day2 실습용 프로덕션 환경 변수
NODE_ENV=production
PORT=3000

# 데이터베이스 설정 (실제 값으로 변경 필요)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=myapp
DB_USER=myapp_user
DB_PASSWORD=your_secure_db_password_here

# Redis 설정 (실제 값으로 변경 필요)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# 로깅 설정
LOG_LEVEL=info

# 애플리케이션 설정
APP_NAME=GitHub Actions Demo Day2
APP_VERSION=2.0.0

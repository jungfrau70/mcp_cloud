# GCP 정적 웹사이트 배포 실습 환경 변수 설정
# 실습2: GCP Cloud Storage 정적 웹사이트 배포

# GCP 프로젝트 설정
PROJECT_ID="goldencircle-470821"
PROJECT_NAME="goldencircle"

# Cloud Storage 버킷 설정
BUCKET_NAME="my-static-website-bucket-123"
LOCATION="asia-northeast3"

# 웹사이트 설정
MAIN_PAGE="index.html"
ERROR_PAGE="404.html"

# 파일 설정
WEBSITE_DIR="static-website"

# AWS 서버리스 투자 제안 심사 시스템 실습 환경 변수 설정
# 실습4: AWS 서버리스 투자 제안 심사 시스템

# 프로젝트 설정
PROJECT_NAME="investment-proposal-system"
LOCATION="ap-northeast-2"

# DynamoDB 설정
TABLE_NAME="InvestmentProposals"
READ_CAPACITY=5
WRITE_CAPACITY=5

# S3 설정
BUCKET_NAME="investment-proposals-docs"
BUCKET_REGION="ap-northeast-2"

# Lambda 설정
LAMBDA_RUNTIME="python3.9"
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_SIZE=256

# API Gateway 설정
API_NAME="Investment Proposals API"
API_DESCRIPTION="투자 제안 심사 시스템 API"
STAGE_NAME="prod"

# SNS 설정
APPROVAL_TOPIC_NAME="investment-approvals"
REJECTION_TOPIC_NAME="investment-rejections"

# Step Functions 설정
STATE_MACHINE_NAME="InvestmentProposalReview"

# CloudWatch 설정
DASHBOARD_NAME="InvestmentProposalsDashboard"

# BigQuery 서버리스 분석 실습 환경 변수 설정
# 실습3: BigQuery 서버리스 분석

# GCP 프로젝트 설정
PROJECT_ID="my-static-website"

# BigQuery 설정
DATASET_ID="sales_analytics"
TABLE_NAME="sales"
LOCATION="asia-northeast3"

# 데이터 설정
DATA_FILE="sales_data.csv"
ANALYSIS_FILE="sales_analysis.json"

# 쿼리 설정
USE_LEGACY_SQL=false
MAX_RESULTS=1000

# 성능 설정
DRY_RUN=true

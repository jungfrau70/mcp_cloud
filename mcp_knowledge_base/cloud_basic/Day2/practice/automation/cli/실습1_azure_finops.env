# Azure FinOps 실습 환경 변수 설정
# 실습1: Azure FinOps 실습 시나리오

# Azure 구독 설정
SUBSCRIPTION_NAME="Wa Investment"
MANAGEMENT_GROUP_ID="MG-Company"

# Azure 도메인 설정 (실제 Azure 테넌트의 검증된 도메인 사용)
# 다음 명령어로 실제 도메인 확인: az ad domain list --output table
AZURE_DOMAIN="spark257.onmicrosoft.com"

# 리소스 그룹 설정
RESOURCE_GROUP_NAME="RG-FinOps-Demo"
LOCATION="koreacentral"

# 스토리지 계정 설정
STORAGE_ACCOUNT_NAME="finopsstorage123"
CONTAINER_NAME="finops-data"

# 사용자 설정 (동적 도메인 사용)
FINANCE_USER="finance_user@${AZURE_DOMAIN}"
IT_ADMIN_USER="itadmin_user@${AZURE_DOMAIN}"
IT_ENGINEER_USER="engineer_user@${AZURE_DOMAIN}"

# 비밀번호 설정 (실제 환경에서는 더 강력한 비밀번호 사용)
USER_PASSWORD="TempPass123!"

# 예산 설정
BUDGET_AMOUNT=100
BUDGET_NAME="MonthlyBudget"

# 정책 설정
POLICY_NAME="AllowedLocations"
POLICY_DISPLAY_NAME="Allowed Locations"
POLICY_DESCRIPTION="한국 리전만 허용"

# 잠금 설정
LOCK_NAME="CanNotDelete"

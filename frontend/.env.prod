# 운영 환경 설정
NODE_ENV=production
NUXT_PUBLIC_API_BASE_URL=https://api.goldencircle.us
NUXT_PUBLIC_WS_BASE_URL=wss://api.goldencircle.us
NUXT_PUBLIC_ENV=production
NUXT_PUBLIC_DEBUG=false
NUXT_PUBLIC_API_KEY=my_mcp_eagle_tiger

# 운영 환경 추가 설정
NUXT_PUBLIC_DOMAIN=gostock.us
NUXT_PUBLIC_FRONTEND_URL=https://app.gostock.us
NUXT_PUBLIC_AUTH_URL=https://auth.gostock.us

# 운영 환경 성능 설정
NUXT_PUBLIC_ANALYTICS=true
NUXT_PUBLIC_TELEMETRY=false

# 운영 환경 보안 설정
NUXT_PUBLIC_SECURE_COOKIES=true
NUXT_PUBLIC_HTTPS_ONLY=true

# 운영 환경 캐시 설정
NUXT_PUBLIC_CACHE_TTL=3600
NUXT_PUBLIC_CACHE_MAX_SIZE=100

# 운영 환경 모니터링
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=

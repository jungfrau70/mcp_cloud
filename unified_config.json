{
  "project": {
    "name": "Cloud Training Platform",
    "version": "1.0.0",
    "description": "대학생 대상 클라우드 강의 수강자를 위한 통합 교육 플랫폼",
    "author": "Cloud Training Team",
    "contact": "training@example.com"
  },
  "courses": {
    "basic": {
      "name": "Cloud Basic",
      "title": "AWS & GCP 기초 서비스 실습",
      "duration_days": 2,
      "target_audience": "클라우드 입문자, 대학생",
      "prerequisites": ["IT 기초 지식", "컴퓨터 사용 경험"],
      "learning_objectives": [
        "클라우드 컴퓨팅 기본 개념 이해",
        "AWS와 GCP 서비스 개요 및 비교",
        "IAM을 통한 사용자 및 권한 관리",
        "가상머신, 스토리지, 네트워크 서비스 기본 활용"
      ],
      "days": {
        "1": {
          "title": "AWS & GCP 기초 서비스 실습",
          "topics": [
            "클라우드 개념 및 계정 생성",
            "IAM 기초 실습",
            "가상머신 서비스 기초",
            "스토리지 서비스 기초"
          ]
        },
        "2": {
          "title": "네트워크, 보안 및 데이터베이스 실습",
          "topics": [
            "네트워킹 기초 실습",
            "보안 그룹 및 방화벽 실습",
            "데이터베이스 서비스 기초",
            "종합 실습 및 비교 분석"
          ]
        }
      }
    },
    "master": {
      "name": "Cloud Master",
      "title": "Docker, Git/GitHub, GitHub Actions 기초 및 VM 기반 배포",
      "duration_days": 3,
      "target_audience": "Cloud Basic 수료자, 중급 개발자",
      "prerequisites": ["Cloud Basic 과정 수료", "클라우드 기본 서비스 실습 경험"],
      "learning_objectives": [
        "Docker를 활용한 웹 애플리케이션 컨테이너화",
        "Git/GitHub을 통한 버전 관리 및 협업",
        "GitHub Actions로 기본 CI/CD 파이프라인 구축",
        "VM 기반 웹 애플리케이션 배포 및 기본 운영"
      ],
      "days": {
        "1": {
          "title": "Docker, Git/GitHub, GitHub Actions 기초",
          "topics": [
            "Docker 기초 및 컨테이너 기술",
            "Git/GitHub 기초 및 협업",
            "GitHub Actions CI/CD 파이프라인",
            "VM 기반 웹 애플리케이션 배포"
          ]
        },
        "2": {
          "title": "고급 CI/CD 및 VM 기반 컨테이너 배포",
          "topics": [
            "Docker 고급 기법 및 최적화",
            "GitHub Actions 고급 워크플로우",
            "VM 기반 컨테이너 배포 자동화",
            "완전 자동화된 배포 파이프라인"
          ]
        },
        "3": {
          "title": "로드 밸런싱, 모니터링, 비용 최적화",
          "topics": [
            "로드 밸런싱 및 Auto Scaling",
            "모니터링 및 로깅 시스템",
            "장애 복구 및 운영 자동화",
            "비용 최적화 및 운영 전략"
          ]
        }
      }
    },
    "container": {
      "name": "Cloud Container",
      "title": "Kubernetes 및 GKE 고급 오케스트레이션",
      "duration_days": 2,
      "target_audience": "Cloud Master 수료자, 고급 개발자",
      "prerequisites": ["Cloud Master 과정 수료", "Docker, Git/GitHub, CI/CD 실습 경험"],
      "learning_objectives": [
        "Kubernetes 클러스터 아키텍처 이해",
        "GKE 클러스터 생성 및 고급 설정",
        "마이크로서비스 아키텍처 구성",
        "ECS Fargate 서비스 배포"
      ],
      "days": {
        "1": {
          "title": "Kubernetes 및 GKE 고급 오케스트레이션",
          "topics": [
            "Kubernetes 고급 아키텍처",
            "컨테이너 오케스트레이션 고급 기법",
            "AWS ECS 및 Fargate 심화",
            "고급 CI/CD 파이프라인"
          ]
        },
        "2": {
          "title": "고가용성 및 확장성 아키텍처",
          "topics": [
            "고가용성 아키텍처 설계",
            "로드 밸런싱 및 Auto Scaling",
            "모니터링 및 로깅 시스템",
            "종합 프로젝트 및 최적화"
          ]
        }
      }
    }
  },
  "cloud_providers": {
    "aws": {
      "name": "Amazon Web Services",
      "region": "us-west-2",
      "free_tier": true,
      "services": [
        "EC2", "S3", "IAM", "VPC", "RDS", "ECS", "Fargate"
      ]
    },
    "gcp": {
      "name": "Google Cloud Platform",
      "region": "us-central1",
      "free_tier": true,
      "credits": 300,
      "services": [
        "Compute Engine", "Cloud Storage", "IAM", "VPC", "Cloud SQL", "GKE"
      ]
    }
  },
  "automation": {
    "project_prefix": "cloud-training",
    "namespace": "default",
    "docker_registry": "docker.io",
    "github_org": "your-org",
    "github_repo": "cloud-training",
    "logging_level": "INFO",
    "results_dir": "automation_results",
    "logs_dir": "logs"
  },
  "student_profile": {
    "target_group": "대학생",
    "background": "클라우드 강의 수강하였으나 친숙하지 않은 사용자",
    "skill_level": "초급-중급",
    "learning_style": "실습 중심",
    "time_commitment": "2-3일 집중 과정",
    "preferred_language": "한국어",
    "support_needs": [
      "단계별 상세 가이드",
      "오류 해결 도움",
      "실습 환경 안정성",
      "진도 추적 및 피드백"
    ]
  },
  "learning_path": {
    "sequence": ["basic", "master", "container"],
    "prerequisites": {
      "master": ["basic"],
      "container": ["master"]
    },
    "integration_points": {
      "basic_to_master": "AWS/GCP 리소스 공유 및 연계 실습",
      "master_to_container": "Docker 이미지 및 CI/CD 파이프라인 연계"
    }
  },
  "assessment": {
    "completion_criteria": {
      "basic": [
        "모든 실습 완료",
        "기본 서비스 활용 능력 확인"
      ],
      "master": [
        "모든 실습 완료",
        "Docker 컨테이너화 능력 확인",
        "CI/CD 파이프라인 구축 능력 확인"
      ],
      "container": [
        "모든 실습 완료",
        "Kubernetes 오케스트레이션 능력 확인",
        "고가용성 아키텍처 설계 능력 확인"
      ]
    },
    "evaluation_methods": [
      "실습 완료도",
      "코드 품질",
      "아키텍처 이해도",
      "문제 해결 능력"
    ]
  },
  "support": {
    "documentation": {
      "language": "한국어",
      "style": "단계별 상세 설명",
      "examples": "실제 사용 사례 중심"
    },
    "troubleshooting": {
      "common_issues": [
        "계정 생성 문제",
        "권한 설정 오류",
        "네트워크 연결 문제",
        "리소스 생성 실패"
      ],
      "support_channels": [
        "실습 가이드 내 해결책",
        "FAQ 섹션",
        "강사 지원"
      ]
    }
  }
}

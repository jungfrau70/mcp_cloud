# 개발 환경 전용 설정
# =====================

# 환경 구분
NODE_ENV=development
ENV=development
DEBUG=true

# 개발 환경 도메인
DOMAIN=localhost
FRONTEND_HOST=localhost:3000
AUTH_HOST=localhost:3000

# 개발 환경 API 설정
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000

# 개발 환경 데이터베이스 (개발용)
POSTGRES_DB=mcp_db_dev
POSTGRES_USER=mcpuser
POSTGRES_PASSWORD=mcppassword
DATABASE_URL=postgresql://mcpuser:mcppassword@mcp_postgres:5432/mcp_db_dev

# 개발 환경 Redis
REDIS_URL=redis://mcp_redis:6379/0

# 개발 환경 Neo4j
NEO4J_AUTH=neo4j/changeme

# 개발 환경 로깅
LOG_LEVEL=debug
LOG_FORMAT=detailed

# 개발 환경 보안 (개발용 키)
JWT_SECRET=dev_jwt_secret_change_me
CREDENTIAL_ENCRYPTION_KEY=dJHoQWeq7456UN3vLje499b4KhPemdFfNamO_YpxE_M=

# 개발 환경 API 키
MCP_API_KEY=my_mcp_eagle_tiger

# 개발 환경 임베딩 설정
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
HF_HUB_OFFLINE=1
HF_LOCAL_FILES_ONLY=1

# 개발 환경 클라우드 설정 (선택사항)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_DEFAULT_LOCATION=koreacentral

# 개발 환경 LLM 키 (선택사항)
GEMINI_API_KEY=

# 개발 환경 테스트 설정
TEST_MODE=true
DISABLE_AUTH=true

# 운영 환경 전용 설정
# =====================

# 환경 구분
NODE_ENV=production
ENV=production
DEBUG=false

# 운영 환경 도메인
DOMAIN=gostock.us
FRONTEND_HOST=app.gostock.us
AUTH_HOST=auth.gostock.us

# 운영 환경 API 설정
API_BASE_URL=https://api.goldencircle.us
WS_BASE_URL=wss://api.goldencircle.us

# 운영 환경 데이터베이스 (운영용)
POSTGRES_DB=mcp_db
POSTGRES_USER=mcpuser
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://mcpuser:changeme@mcp_postgres:5432/mcp_db

# 운영 환경 Redis
REDIS_URL=redis://mcp_redis:6379/0

# 운영 환경 Neo4j
NEO4J_AUTH=neo4j/changeme

# 운영 환경 로깅
LOG_LEVEL=info
LOG_FORMAT=json

# 운영 환경 보안 (운영용 강력한 키)
JWT_SECRET=prod_jwt_secret_change_me_in_production
CREDENTIAL_ENCRYPTION_KEY=IUYtNLgRduOMZ0BHxLK22r_5PBh0vvrzC2EZRD4HiKs=

# 운영 환경 API 키
MCP_API_KEY=my_mcp_eagle_tiger

# 운영 환경 임베딩 설정
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
HF_HUB_OFFLINE=1
HF_LOCAL_FILES_ONLY=1

# 운영 환경 클라우드 설정 (실제 키 필요)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_DEFAULT_LOCATION=koreacentral

# 운영 환경 LLM 키 (실제 키 필요)
GEMINI_API_KEY=

# 운영 환경 보안 설정
TEST_MODE=false
DISABLE_AUTH=false

# Cloudflare Tunnel 설정
CLOUDFLARE_TUNNEL_NAME=mcp-cloud
CLOUDFLARE_LOGLEVEL=info

# NPM 초기화 설정
NPM_INIT_EMAIL=admin@gostock.us
NPM_INIT_PASS=ChangeMe_123
